<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Uses the Akka libraries through the akka-dependencies BOM the way Maven users do, to verify the
         dependencies Maven resolves. One module per library, so that each resolves on its own.
         Run with -Dakka-dependencies.version=<version published to the local Maven repository> -->

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.lightbend.akka</groupId>
    <artifactId>akka-dependencies-maven-tests</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>akka-core</module>
        <module>akka-http</module>
        <module>akka-grpc</module>
        <module>akka-management</module>
        <module>akka-management-loglevels-logback</module>
        <module>akka-management-loglevels-log4j2</module>
        <module>akka-discovery-aws-api</module>
        <module>akka-discovery-aws-api-async</module>
        <module>akka-discovery-azure-api</module>
        <module>akka-persistence-r2dbc</module>
        <module>akka-persistence-jdbc</module>
        <module>akka-persistence-cassandra</module>
        <module>akka-persistence-dynamodb</module>
        <module>akka-projection</module>
        <module>alpakka-kafka</module>
        <module>alpakka-csv</module>
        <module>akka-diagnostics</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
        <scala.binary.version>2.13</scala.binary.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.lightbend.akka</groupId>
                <artifactId>akka-dependencies</artifactId>
                <version>${akka-dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Maven picks the nearest version, not the highest like sbt. Fails if that gives
                                     a dependency an older version than another path in the tree asks for. -->
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>
        </plugins>
    </build>
</project>
